# ============================================================
# 复制本文件为 .env，并填入你的真实 API Key。
# .env 已被 .gitignore 忽略，切勿提交到 GitHub。
# ============================================================

# DeepSeek 官方 API（OpenAI 兼容）。也可换成任意 OpenAI 兼容端点：
#   base_url 填你服务商的地址，api_key 填对应密钥。
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：接口限流与重试。step-* 模型未配置时自动按 9 RPM 节流。
LLM_RPM_LIMIT=9
LLM_MAX_CONCURRENCY=4
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=10
LLM_MAX_TOKENS=800
